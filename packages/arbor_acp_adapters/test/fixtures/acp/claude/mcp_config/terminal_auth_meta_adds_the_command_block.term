[
  %Arbor.ACP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %Arbor.ACP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-init",
        "jsonrpc" => "2.0",
        "method" => "initialize",
        "params" => %{"clientCapabilities" => %{"_meta" => %{"terminal-auth" => true}}}
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %Arbor.ACP.Test.ClaudeGolden.Entry{
    step: %{kind: :auth_methods, opts: [cli_path: "<sandbox>/bin/claude"]},
    result: %{
      reply: [
        %{
          "_meta" => %{
            "terminal-auth" => %{
              "args" => ["auth", "login", "--claudeai"],
              "command" => "<sandbox>/bin/claude",
              "env" => %{"CLAUDE_CONFIG_DIR" => "<generated-runtime-home>"},
              "label" => "Claude Login"
            }
          },
          "args" => ["auth", "login", "--claudeai"],
          "description" => "Use Claude subscription",
          "env" => %{"CLAUDE_CONFIG_DIR" => "<generated-runtime-home>"},
          "id" => "claude-ai-login",
          "name" => "Claude Subscription",
          "type" => "terminal"
        },
        %{
          "_meta" => %{
            "terminal-auth" => %{
              "args" => ["auth", "login", "--console"],
              "command" => "<sandbox>/bin/claude",
              "env" => %{"CLAUDE_CONFIG_DIR" => "<generated-runtime-home>"},
              "label" => "Anthropic Console Login"
            }
          },
          "args" => ["auth", "login", "--console"],
          "description" => "Use Anthropic Console (API usage billing)",
          "env" => %{"CLAUDE_CONFIG_DIR" => "<generated-runtime-home>"},
          "id" => "console-login",
          "name" => "Anthropic Console",
          "type" => "terminal"
        }
      ],
      tag: :ok
    }
  }
]
