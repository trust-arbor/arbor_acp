[
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "pi-<1>", "type" => "new_session"}]}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "new_session",
        "error" => "boom",
        "id" => "pi-<1>",
        "success" => false,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{"error" => %{"code" => -32603, "message" => "boom"}, "id" => 1, "jsonrpc" => "2.0"}
      ],
      tag: :messages
    }
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{kind: :note, text: "An extension cancelling the switch leaves Pi on its session"},
    result: %{}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "pi-<2>", "type" => "new_session"}]}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "new_session",
        "data" => %{"cancelled" => true},
        "id" => "pi-<2>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "Pi cancelled the session change"},
          "id" => 2,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  }
]
