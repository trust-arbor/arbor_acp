[
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "mapped" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/mapped.jsonl",
            "sessionId" => "mapped"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/load",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "mapped"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<1>",
          "sessionPath" => "<sandbox>/sessions/mapped.jsonl",
          "type" => "switch_session"
        }
      ]
    }
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "switch_session",
        "error" => "no such session",
        "id" => "pi-<1>",
        "success" => false,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "no such session"},
          "id" => 1,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/resume",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "mapped"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<2>",
          "sessionPath" => "<sandbox>/sessions/mapped.jsonl",
          "type" => "switch_session"
        }
      ]
    }
  },
  %Arbor.ACP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "switch_session",
        "data" => %{"cancelled" => true},
        "id" => "pi-<2>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "Pi cancelled the session change"},
          "id" => 2,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  }
]
